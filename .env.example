# ==============================================================================
# Keystatic Configuration
# ==============================================================================
# Mode penyimpanan Keystatic:
# - Secara default: 'local' pada mode development, dan 'github' pada production.
# - Bila ingin memaksa mode tertentu, aktifkan baris di bawah ('local' atau 'github'):
# PUBLIC_KEYSTATIC_STORAGE_KIND=local

# Konfigurasi Repositori GitHub
PUBLIC_KEYSTATIC_REPO_OWNER=iZuul
PUBLIC_KEYSTATIC_REPO_NAME=curriculum-vitae

# Kredensial GitHub App untuk Keystatic (Wajib diisi pada Production / Vercel):
# Dapatkan nilai ini melalui wizard otomatis saat pertama kali membuka /keystatic di production,
# atau buat secara manual di GitHub Developer Settings > GitHub Apps.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Secret acak 32-karakter untuk enkripsi session cookie (bisa di-generate via `openssl rand -base64 32`)
KEYSTATIC_SECRET=

# Slug GitHub App yang terdaftar (contoh: izuul-portfolio-keystatic)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
