---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Skills from '../components/sections/Skills.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/Footer.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const about = await reader.singletons.about.read();
const skills = await reader.singletons.skills.read();
---

<BaseLayout
  title={`${about?.name ?? 'Muhammad Zulfa Dhiaulhaq'} — Software Engineer`}
  description={about?.tagline ?? 'Portfolio of Muhammad Zulfa Dhiaulhaq, a Software Engineer based in Yogyakarta, Indonesia.'}
>
  <Navbar name={about?.name} />
  <main>
    <Hero
      name={about?.name}
      role={about?.role}
      tagline={about?.tagline}
      github={about?.github ?? undefined}
      email={about?.email ?? undefined}
    />
    <About
      bio={about?.bio ?? undefined}
      greeting={about?.greeting ?? undefined}
      location={about?.location ?? undefined}
      education={about?.education ?? undefined}
      focus={about?.focus ?? undefined}
      status={about?.status ?? undefined}
      email={about?.email ?? undefined}
      github={about?.github ?? undefined}
      linkedin={about?.linkedin ?? undefined}
      twitter={about?.twitter ?? undefined}
      photo={about?.photo ?? undefined}
    />
    <Skills categories={skills?.categories ?? []} />
    <Contact
      email={about?.email ?? undefined}
      github={about?.github ?? undefined}
      linkedin={about?.linkedin ?? undefined}
      heading={about?.contact_heading ?? undefined}
      description={about?.contact_description ?? undefined}
    />
  </main>
  <Footer name={about?.name} />
</BaseLayout>
