---
interface Props {
  name?: string;
}
const { name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-100 dark:border-zinc-900 transition-colors duration-300">
  <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-zinc-400 dark:text-zinc-600">
      &copy; {year} {name ?? 'Muhammad Zulfa Dhiaulhaq'}
    </p>
    <p class="text-sm text-zinc-400 dark:text-zinc-600">
      Built with <a href="https://astro.build" target="_blank" rel="noopener" class="hover:text-zinc-600 dark:hover:text-zinc-400 transition-colors underline underline-offset-2">Astro</a> & <a href="https://keystatic.com" target="_blank" rel="noopener" class="hover:text-zinc-600 dark:hover:text-zinc-400 transition-colors underline underline-offset-2">Keystatic</a>
    </p>
  </div>
</footer>
